# Copy to .env.local (not committed). Expo reads EXPO_PUBLIC_* variables at build time.

# Where the Doulisha API runs (the web app). Leave empty for the defaults:
# - development builds: http://10.0.2.2:3000 (the Android emulator's name for your computer)
# - preview and production builds: https://doulisha.vercel.app
# On a real phone, use your computer's Wi-Fi address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=
